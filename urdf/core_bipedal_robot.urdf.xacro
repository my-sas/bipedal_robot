<?xml version="1.0"?>
<robot name="bipedal_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<link name="base_link">
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<box size="0.05 0.08 0.08" />
			</geometry>
			<material name="blue">
				<color rgba="0 0 1 1"/>
			</material>
		</visual>
		<collision name="base_link">
		    <origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<box size="0.05 0.08 0.08" />
			</geometry>
		</collision>
		<inertial>
            <mass value="0.16"/>
		    <origin xyz="0 0 0"/>
		    <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
		</inertial>
	</link>

	<xacro:macro name="leg" params="name shift">
        <link name="${name}_thigh">
            <visual>
                <origin xyz="0 0 -0.05" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.1"/>
                </geometry>
                <material name="blue">
                    <color rgba="0 0 1 1"/>
                </material>
            </visual>
            <collision name="${name}_thigh_collision">
                <origin xyz="0 0 -0.05" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.1"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.16"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
            </inertial>
        </link>

        <link name="${name}_shin">
            <visual>
                <origin xyz="0 0 -0.05" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.1"/>
                </geometry>
                <material name="blue">
                    <color rgba="0 0 1 1"/>
                </material>
            </visual>
            <collision name="${name}_shin_collision">
                <origin xyz="0 0 -0.05" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.1"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.16"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
            </inertial>
        </link>

        <link name="${name}_foot">
            <visual>
                <origin xyz="0 0 -0.005" rpy="0 0 0"/>
                <geometry>
                    <box size="0.05 0.04 0.01" />
                </geometry>
                <material name="blue">
                    <color rgba="0 0 1 1"/>
                </material>
            </visual>
            <collision name="${name}_foot_collision">
                <origin xyz="0 0 -0.005" rpy="0 0 0"/>
                <geometry>
                    <box size="0.05 0.04 0.01" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.02"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
            </inertial>
        </link>

        <joint name="${name}_hip_joint" type="revolute">
            <parent link="base_link"/>
            <child link="${name}_thigh"/>
            <origin xyz="0 ${shift} -0.04" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="-1.57" upper="1.57" effort="30" velocity="1.5"/>
            <dynamics damping="0.5" friction="0.3"/>
        </joint>

        <joint name="${name}_knee_joint" type="revolute">
            <parent link="${name}_thigh"/>
            <child link="${name}_shin"/>
            <origin xyz="0 0 -0.1" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="0.0" upper="1.57" effort="30" velocity="1"/>
            <dynamics damping="0.5" friction="0.3"/>
        </joint>

        <joint name="${name}_ankle_joint" type="revolute">
            <parent link="${name}_shin"/>
            <child link="${name}_foot"/>
            <origin xyz="0 0 -0.1" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="-1.57" upper="1.57" effort="30" velocity="1"/>
            <dynamics damping="0.5" friction="0.3"/>
        </joint>
	</xacro:macro>

	<xacro:leg name="left" shift="0.04"/>
	<xacro:leg name="right" shift="-0.04"/>
</robot>